# Local development configuration. Copy to .env and keep real keys out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=local-development-secret-change-me

# Host defaults; Docker Compose supplies its own database address.
DATABASE_URL=postgresql+psycopg://asklio:asklio@localhost:5432/asklio
CORS_ORIGINS=http://localhost:3200
